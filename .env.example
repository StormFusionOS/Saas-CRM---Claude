# ==============================================================================
# PRODUCTION-READY MONOREPO ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values for production.
# The defaults below are safe for local development.

# ------------------------------------------------------------------------------
# BRANDING & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
COMPANY_NAME=YourCompany
BASE_DOMAIN=example.com

# CRM SPA: https://crm.example.com
# Ops Console SPA: https://ops.example.com

# ------------------------------------------------------------------------------
# JWT SECRETS (Change these in production!)
# ------------------------------------------------------------------------------
CRM_SECRET_KEY=crm-dev-secret-key-change-in-production-min-32-chars
OPS_SECRET_KEY=ops-dev-secret-key-change-in-production-min-32-chars

# Token TTL (in seconds)
CRM_ACCESS_TOKEN_EXPIRE=900        # 15 minutes
CRM_REFRESH_TOKEN_EXPIRE=604800    # 7 days
OPS_ACCESS_TOKEN_EXPIRE=900
OPS_REFRESH_TOKEN_EXPIRE=604800

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# CRM Database
CRM_DB_HOST=localhost
CRM_DB_PORT=5433
CRM_DB_NAME=crm
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=crm_password

# Ops Database
OPS_DB_HOST=localhost
OPS_DB_PORT=5434
OPS_DB_NAME=ops
OPS_DB_USER=ops_user
OPS_DB_PASSWORD=ops_password

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# WEBHOOK & INTEGRATION SECRETS
# ------------------------------------------------------------------------------
# Twilio
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here

# Facebook
FB_APP_SECRET=your-facebook-app-secret-here
FB_VERIFY_TOKEN=your-facebook-verify-token-here

# Google
GOOGLE_WEBHOOK_SECRET=your-google-webhook-secret-here

# ------------------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------------------
# CRM API
CRM_API_HOST=0.0.0.0
CRM_API_PORT=8000
CRM_API_PREFIX=/api/v1
CRM_API_DEBUG=true

# Ops API
OPS_API_HOST=0.0.0.0
OPS_API_PORT=8001
OPS_API_PREFIX=/api/v1
OPS_API_DEBUG=true

# CORS origins (comma-separated)
CRM_CORS_ORIGINS=http://localhost:5173,https://crm.example.com
OPS_CORS_ORIGINS=http://localhost:5174,https://ops.example.com

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# These are used by Vite at build time
VITE_CRM_API_URL=http://localhost:8000/api/v1
VITE_OPS_API_URL=http://localhost:8001/api/v1

# ------------------------------------------------------------------------------
# CELERY CONFIGURATION
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# ------------------------------------------------------------------------------
# LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (optional)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (for auto-replies)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=false

# ------------------------------------------------------------------------------
# SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# File integrity check paths (comma-separated)
FILE_INTEGRITY_PATHS=/etc/nginx,/var/www

# ------------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ------------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ------------------------------------------------------------------------------
# AI/ML CONFIGURATION
# ------------------------------------------------------------------------------
# OpenAI or similar (for AI pipeline)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# Feature flags
AI_SUGGESTIONS_ENABLED=false
AUTO_REPLY_ENABLED=false
