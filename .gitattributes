# ==============================================================================
# Git Attributes Configuration
# ==============================================================================
# Ensures consistent line endings and proper handling of binary files
# See: https://git-scm.com/docs/gitattributes

# ==============================================================================
# Default Behavior
# ==============================================================================
# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# ==============================================================================
# Source Code Files - Force LF
# ==============================================================================
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# ==============================================================================
# Documentation - Force LF
# ==============================================================================
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
LICENSE text eol=lf
CHANGELOG text eol=lf
README text eol=lf
CONTRIBUTING text eol=lf
*.markdown text eol=lf

# ==============================================================================
# Configuration Files - Force LF
# ==============================================================================
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# ==============================================================================
# Build and Package Files
# ==============================================================================
package.json text eol=lf
package-lock.json text eol=lf
*.lock text eol=lf
requirements.txt text eol=lf
requirements-*.txt text eol=lf
setup.py text eol=lf
setup.cfg text eol=lf
pyproject.toml text eol=lf
Pipfile text eol=lf
Pipfile.lock text eol=lf

# ==============================================================================
# Binary Files
# ==============================================================================
# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.bmp binary
*.tiff binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.gz binary
*.zip binary
*.tar binary
*.tgz binary
*.rar binary
*.7z binary
*.bz2 binary
*.xz binary

# Media
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.wav binary
*.ogg binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Databases
*.db binary
*.sqlite binary
*.sqlite3 binary

# Other binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.class binary
*.pyc binary
*.pyo binary
*.o binary
*.a binary

# ==============================================================================
# Special Handling
# ==============================================================================
# Treat Jupyter notebooks as text but merge carefully
*.ipynb text eol=lf merge=union

# Certificate files (should not be in repo, but if they are, treat as binary)
*.pem binary
*.key binary
*.crt binary
*.cer binary
*.p12 binary
*.pfx binary

# ==============================================================================
# Git LFS (Large File Storage) - Optional
# ==============================================================================
# Uncomment to track large files with Git LFS
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text
# *.sketch filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# Language-Specific Diff Patterns
# ==============================================================================
*.py diff=python
*.js diff=javascript
*.ts diff=typescript
*.html diff=html
*.css diff=css
*.md diff=markdown

# ==============================================================================
# Export Ignore
# ==============================================================================
# Files to exclude from git archive exports
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.github export-ignore
.vscode export-ignore
.idea export-ignore
tests/ export-ignore
docs/ export-ignore
*.test.* export-ignore
*.spec.* export-ignore
