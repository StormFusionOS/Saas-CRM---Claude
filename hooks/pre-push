#!/bin/bash
#
# Pre-push hook for RiverCityClean SaaS CRM
# Runs comprehensive quality gates before allowing push to remote
#
# Installation:
#   From project root:
#   cp hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Or use symlink (changes auto-update):
#   ln -sf ../../hooks/pre-push .git/hooks/pre-push
#
# Bypass (use with caution, requires approval):
#   git push --no-verify
#
# See docs/GIT_HOOKS.md for full documentation
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# Get the root directory of the repository
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Change to repo root
cd "$REPO_ROOT"

echo ""
echo -e "${CYAN}${BOLD}═══════════════════════════════════════════════════════════════════════════════${RESET}"
echo -e "${CYAN}${BOLD}                              PRE-PUSH QUALITY GATES${RESET}"
echo -e "${CYAN}${BOLD}═══════════════════════════════════════════════════════════════════════════════${RESET}"
echo ""
echo -e "${CYAN}Running quality checks before push...${RESET}"
echo ""

# Check if prepush script exists
if [[ ! -f "./scripts/prepush.sh" ]]; then
  echo -e "${RED}Error: scripts/prepush.sh not found${RESET}"
  echo "Please ensure you're in the project root directory."
  exit 1
fi

# Run the prepush script
if ./scripts/prepush.sh; then
  echo ""
  echo -e "${GREEN}${BOLD}Push allowed - all quality gates passed${RESET}"
  echo ""
  exit 0
else
  echo ""
  echo -e "${RED}${BOLD}Push blocked - quality gates failed${RESET}"
  echo ""
  echo "Fix the issues above and try again."
  echo "To bypass this hook (not recommended): git push --no-verify"
  echo ""
  exit 1
fi
